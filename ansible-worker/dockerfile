FROM python:3.13

RUN apt-get update && apt-get install -y \
    openssh-client \
    openssh-server \
    && rm -rf /var/lib/apt/lists/*

# Настройка SSH для поддержки старых устройств Cisco
RUN mkdir -p /etc/ssh && \
    echo "Host *" >> /etc/ssh/ssh_config && \
    echo "    KexAlgorithms +diffie-hellman-group1-sha1,diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1" >> /etc/ssh/ssh_config && \
    echo "    HostKeyAlgorithms +ssh-rsa,ssh-dss" >> /etc/ssh/ssh_config && \
    echo "    Ciphers +aes128-cbc,aes192-cbc,aes256-cbc,3des-cbc" >> /etc/ssh/ssh_config && \
    echo "    MACs +hmac-sha1,hmac-md5" >> /etc/ssh/ssh_config

RUN pip install --upgrade pip && \
    pip install 'celery==5.6.0' && \
    pip install --upgrade 'ansible>=10.0.0'

# Устанавливаем все популярные коллекции
RUN ansible-galaxy collection install ansible.netcommon || true; \
    ansible-galaxy collection install cisco.ios || true; \
    ansible-galaxy collection install cisco.nxos || true; \
    ansible-galaxy collection install junipernetworks.junos || true; \
    ansible-galaxy collection install arista.eos || true; \
    ansible-galaxy collection install fortinet.fortios || true; \
    ansible-galaxy collection install community.network || true

WORKDIR /app

RUN pip install --no-cache-dir redis pyyaml ansible-pylibssh
